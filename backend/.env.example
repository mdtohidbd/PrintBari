# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# MongoDB Configuration
# Local instance or MongoDB Atlas URI:
# e.g., mongodb+srv://<db_username>:<db_password>@cluster0.jlom6nc.mongodb.net/docustudio_saas?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.jlom6nc.mongodb.net/docustudio_saas?retryWrites=true&w=majority

# Client / CORS
CORS_ORIGIN=http://localhost:5173

# Logging Level (error, warn, info, http, verbose, debug, silly)
LOG_LEVEL=info
